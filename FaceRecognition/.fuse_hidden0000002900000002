import os
import cv2
import numpy as np
import faceRecognition as fr
import pickle


#This module captures images via webcam and performs face recognition
face_recognizer = cv2.face.LBPHFaceRecognizer_create()
face_recognizer.read('trainingData.yml')#Load saved training data

with open('labelWajah.pkl', 'rb') as bacaLbl:
    name = pickle.load(bacaLbl)
#name = ["Fajar Amrullah", "Rusman TS"]


#cap=cv2.VideoCapture('http://192.168.100.218:4747/video')
cap=cv2.VideoCapture(0)
while True:
    ret,test_img=cap.read()# captures frame and returns boolean value and captured image
    faces_detected,gray_img=fr.faceDetection(test_img)



    for (x,y,w,h) in faces_detected:
        cv2.rectangle(test_img,(x,y),(x+w,y+h),(255,0,0),thickness=3)
        roi_gray=gray_img[y:y+w, x:x+h]
        label,confidence=face_recognizer.predict(roi_gray)#predicting the label of given image
        #print(label)
        predicted_name=name[label]

        if confidence > 35 and confidence < 90:
            tt = predicted_name+', '+str(int(confidence))+'%'
            #print(tt)
            cv2.putText(test_img, tt, (x, y), cv2.FONT_HERSHEY_SIMPLEX, fontScale=1,thickness=1, color=(15,15, 249))
        #fr.draw_rect(test_img,face)
        
        # if confidence < 39:#If confidence less than 37 then don't print predicted face text on screen
        #    fr.put_text(test_img,predicted_name,x,y)


    resized_img = cv2.resize(test_img, (1000, 700))
    cv2.imshow('face recognition tutorial ',resized_img)
    if cv2.waitKey(10) == ord('q'):#wait until 'q' key is pressed
        break


cap.release()
cv2.destroyAllWindows

